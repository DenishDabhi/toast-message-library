{
  "name": "react-native-toast-message-library",
  "version": "0.1.0",
  "description": "Lightweight, customizable toast notifications for React Native: queue, themes, animations, actions, swipe-to-dismiss and accessibility. Pure JavaScript, no native modules.",
  "main": "src/index.js",
  "react-native": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "types/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src demo __tests__ App.js index.js --ext .js",
    "typecheck": "tsc --noEmit -p types/tsconfig.json",
    "validate": "npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "toast",
    "notification",
    "snackbar",
    "ios",
    "android",
    "toast-notification"
  ],
  "license": "MIT",
  "author": "Denish Dabhi <dabhidenish57@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2",
    "test-renderer": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}

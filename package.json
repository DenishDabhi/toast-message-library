{
  "name": "react-native-toast-message-library",
  "version": "1.0.6",
  "description": "An independent, customizable toast notification toolkit for React Native. Supports Android, iOS and Expo with queued notifications, snackbar layouts, action buttons, swipe-to-dismiss, themes and TypeScript. Lightweight JavaScript implementation with no custom native modules.",
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "types/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build": "babel src --out-dir dist --extensions .js,.jsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src demo __tests__ App.js index.js --ext .js",
    "typecheck": "tsc --noEmit -p types/tsconfig.json",
    "validate": "npm run build && npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "react-native-toast",
    "react-native-snackbar",
    "react-native-notification",
    "react-native-toast-message-library",
    "toast",
    "toast-message",
    "toast-notification",
    "toaster",
    "snackbar",
    "notification",
    "alert"
  ],
  "license": "MIT",
  "author": "Denish Dabhi <dabhidenish57@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenishDabhi/toast-message-library.git"
  },
  "bugs": {
    "url": "https://github.com/DenishDabhi/toast-message-library/issues"
  },
  "homepage": "https://github.com/DenishDabhi/toast-message-library#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2",
    "test-renderer": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
